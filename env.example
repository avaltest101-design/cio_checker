# Copy this file to ".env" for local dev, or set these in the Netlify dashboard.
# NEVER commit your real key. The frontend never reads this value directly;
# only the Netlify serverless function (netlify/functions/analyze-coi.js) does.

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model used by the serverless function.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
